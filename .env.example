# Public URL of the deployed app, used for Paddle redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — safe to expose to the browser. Format: sb_publishable_...
# Replaces the legacy `anon` JWT (which is being deprecated end of 2026).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — server-only, bypasses Row Level Security. Format: sb_secret_...
# Replaces the legacy `service_role` JWT. Used by the analyze + Paddle webhook
# routes to credit analyses and flip subscription state.
SUPABASE_SECRET_KEY=

# ── Gemini (Google AI Studio) ────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Paddle Billing ───────────────────────────────────────────────────────────
# Paddle dashboard → Developer Tools → Authentication.
PADDLE_API_KEY=
# Paddle dashboard → Catalog → Products → your $9.99/mo price ID.
PADDLE_PRICE_ID=
# Notifications → endpoint secret. Used to verify webhook signatures.
PADDLE_NOTIFICATION_KEY=
# 'sandbox' for testing, 'production' for live billing.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ── Sentry ───────────────────────────────────────────────────────────────────
# Sentry project DSN. Public on the client.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only. Allows source-map upload during `next build`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
